# PokeSketchDex configuration — copy to .env and fill in. NEVER commit .env.

# Required: Discord bot token from https://discord.com/developers/applications
POKESKETCH_DISCORD_TOKEN=

# Optional: comma-separated guild IDs to register slash commands to instantly
# (dev convenience). Leave blank to register commands globally (up to ~1h to
# propagate). Example: 123456789012345678,987654321098765432
POKESKETCH_DEV_GUILD_IDS=

# Optional: path to the SQLite database file (default: data/pokesketch.db)
POKESKETCH_DB_PATH=data/pokesketch.db

# Optional: directory for cached reference images (default: data/images_cache)
POKESKETCH_IMAGE_CACHE_DIR=data/images_cache

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default: INFO
POKESKETCH_LOG_LEVEL=INFO
