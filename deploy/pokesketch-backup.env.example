# Copy to /etc/pokesketch-backup.env (do not commit the filled-in file).
# Create the remote directory and verify SSH host keys before enabling remote backups.
BACKUP_REMOTE_DEST=backup-user@backup-host.example:/path/to/backups/
# Optional: omit to use the service user's default SSH identity.
# Key paths may contain only letters, digits, _, ., / and - (no spaces).
BACKUP_SSH_KEY=/path/to/backup-ssh-key
